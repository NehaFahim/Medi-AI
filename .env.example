# Copy this file to ".env" for local development (never commit .env).
# On Vercel: Project -> Settings -> Environment Variables, then redeploy.

# Required. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults shown.
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODEL=gemini-3.6-flash

# Optional. Total time budget per analysis in ms (keep below your host's limit).
# ANALYZE_TIMEOUT_MS=52000

# Optional (local server only)
# PORT=3000
